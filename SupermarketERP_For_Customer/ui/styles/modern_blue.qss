/* Main Window */
QMainWindow {
    background-color: #f5f5f5;
}

/* Menu Bar */
QMenuBar {
    background-color: #2196F3;
    color: white;
    padding: 2px;
    min-height: 20px;
}

QMenuBar::item {
    background-color: transparent;
    color: white;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #1976D2;
    border-radius: 3px;
}

/* Menu */
QMenu {
    background-color: white;
    border: 1px solid #ddd;
    padding: 3px;
}

QMenu::item {
    padding: 4px 15px;
    color: #333;
}

QMenu::item:selected {
    background-color: #2196F3;
    color: white;
}

/* Toolbar */
QToolBar {
    background-color: white;
    border: none;
    border-bottom: 1px solid #ddd;
    padding: 2px;
    spacing: 3px;
}

QToolButton {
    background-color: transparent;
    border: none;
    padding: 4px;
    border-radius: 3px;
    min-width: 50px;
}

QToolButton:hover {
    background-color: #e3f2fd;
}

/* Status Bar */
QStatusBar {
    background-color: #333;
    color: white;
    padding: 2px;
    max-height: 20px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #ddd;
    background-color: white;
}

QTabBar::tab {
    background-color: #f5f5f5;
    border: 1px solid #ddd;
    padding: 6px 12px;
    margin-right: 2px;
    min-width: 60px;
}

QTabBar::tab:selected {
    background-color: white;
    border-bottom-color: white;
}

QTabBar::tab:hover {
    background-color: #e3f2fd;
}

/* Buttons */
QPushButton {
    background-color: #2196F3;
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
    font-weight: bold;
    min-height: 25px;
}

QPushButton:hover {
    background-color: #1976D2;
}

QPushButton:pressed {
    background-color: #0D47A1;
}

QPushButton:disabled {
    background-color: #bdbdbd;
}

/* Secondary Button */
QPushButton#secondaryButton {
    background-color: #FFC107;
    color: #333;
}

QPushButton#secondaryButton:hover {
    background-color: #FFB300;
}

/* Danger Button */
QPushButton#dangerButton {
    background-color: #F44336;
}

QPushButton#dangerButton:hover {
    background-color: #D32F2F;
}

/* Line Edit */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit {
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 5px;
    selection-background-color: #2196F3;
    min-height: 20px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateEdit:focus {
    border: 2px solid #2196F3;
}

/* Table Views */
QTableView {
    background-color: white;
    alternate-background-color: #f9f9f9;
    selection-background-color: #e3f2fd;
    selection-color: #333;
    gridline-color: #ddd;
    border: 1px solid #ddd;
}

QTableView::item {
    padding: 4px;
}

QTableView::item:selected {
    background-color: #bbdefb;
    color: #333;
}

QHeaderView::section {
    background-color: #f5f5f5;
    padding: 5px;
    border: none;
    border-right: 1px solid #ddd;
    border-bottom: 1px solid #ddd;
    font-weight: bold;
}

/* Group Box */
QGroupBox {
    border: 1px solid #ddd;
    border-radius: 5px;
    margin-top: 8px;
    padding-top: 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}

/* Scroll Bars */
QScrollBar:vertical {
    border: none;
    background-color: #f5f5f5;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #bdbdbd;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9e9e9e;
}

QScrollBar:horizontal {
    border: none;
    background-color: #f5f5f5;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #bdbdbd;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9e9e9e;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #ddd;
    border-radius: 3px;
    text-align: center;
    min-height: 15px;
}

QProgressBar::chunk {
    background-color: #2196F3;
    border-radius: 3px;
}

/* Message Box */
QMessageBox {
    background-color: white;
}

QMessageBox QLabel {
    color: #333;
    padding: 8px;
}

/* Dialog */
QDialog {
    background-color: white;
}

/* Frame */
QFrame {
    background-color: transparent;
}
